{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muselet.local/schemas/systemone-response.schema.json",
  "title": "DeskMind System One response or error",
  "oneOf": [
    {
      "type": "object",
      "required": ["id", "model", "answers", "usage", "latency_ms"],
      "properties": {
        "id": {"type": "string"},
        "model": {"type": "string"},
        "answers": {"type": "object", "additionalProperties": {"$ref": "#/$defs/answer"}},
        "usage": {
          "type": "object",
          "required": ["input_tokens", "output_tokens"],
          "properties": {
            "input_tokens": {"type": ["integer", "null"]},
            "output_tokens": {"type": "integer"}
          }
        },
        "latency_ms": {"type": "number", "minimum": 0},
        "cached": {"type": "boolean"},
        "request_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "step": {"type": "integer", "minimum": 1}
      }
    },
    {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {"type": "string"},
            "message": {"type": "string"},
            "retryable": {"type": "boolean"},
            "field": {"type": "string"}
          }
        }
      }
    }
  ],
  "$defs": {
    "probabilities": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "noul", "probabilities"],
          "properties": {
            "type": {"const": "noul"},
            "noul": {"type": "number", "minimum": 0, "maximum": 1},
            "probabilities": {"$ref": "#/$defs/probabilities"}
          }
        },
        {
          "type": "object",
          "required": ["type", "choice", "probabilities", "confidence"],
          "properties": {
            "type": {"const": "choice"},
            "choice": {"type": "string"},
            "probabilities": {"$ref": "#/$defs/probabilities"},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "score", "legend", "probabilities", "confidence"],
          "properties": {
            "type": {"const": "score"},
            "score": {"type": "number"},
            "legend": {"type": "object"},
            "probabilities": {"$ref": "#/$defs/probabilities"},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      ]
    }
  }
}
