tell application id "com.apple.Notes"
	set acct to default account
	if not (exists folder "Clients" of acct) then make new folder at acct with properties {name:"Clients"}
	set f to folder "Clients" of acct
	set hits to (every note of f whose name is "Henderson — annual review prep (Muselet)")
	if (count of hits) > 0 then
		set n to item 1 of hits
		set body of n to "<h1>Henderson — annual review prep (Muselet)</h1><div>Henderson annual review, Mon Oct 26, 2026, 10:00-11:00 · data as of 2026-10-23, computed on this Mac</div><h2>Snapshot</h2><ul><li>Household assets $1,739,656.00: invested $1,503,176.00, savings $236,480.00.</li><li>Allocation vs target (band ±5 pp):</li><ul><li>US equity 47.50% vs 40.00% (+7.50 pp, outside band)</li><li>Intl equity 20.37% vs 20.00% (+0.37 pp)</li><li>Bonds 27.14% vs 35.00% (-7.86 pp, outside band)</li><li>Cash 4.99% vs 5.00% (-0.01 pp)</li><li>Equity total 67.87% vs 60.00% (+7.87 pp, outside band)</li></ul></ul><h2>Opportunities</h2><div>Listed by dollar size; the amounts are different kinds (trades, idle cash, tax room, losses, gains) and are not added together.</div><ol><li><b>Rebalance back to target</b>: $118,151.60 to move. Sell $112,785.60 VTI and $5,524.80 VXUS; buy $118,151.60 AGG in Mark Traditional IRA. AGG instead of BND keeps the BND harvest clean. Realized gain $0.00.</li><li><b>Invest excess savings</b>: $68,480.00 idle in savings. Savings $236,480.00 minus 6-month reserve $48,000.00 minus lake house down payment $120,000.00.</li><li><b>Roth conversion window</b>: $61,400.00 convertible at 22% or less. 22% bracket top $211,400.00 minus taxable income $150,000.00 (2026, IRS Rev. Proc. 2025-32).</li><li><b>Gift appreciated stock to a donor-advised fund</b>: $53,472.00 capital gains avoided. AAPL (2012-09-17) +925.61%, MSFT (2015-11-02) +810.04%; $59,652.00 market value.</li><li><b>Tax-loss harvesting</b>: $30,825.00 losses harvestable now. BND (2021-08-02) $21,825.00 → AGG; VNQ (2022-01-03) $9,000.00 → SCHH. VXUS (2026-02-09) $3,640.00 is wash-sale blocked by the 2026-10-11 buy in Mark Traditional IRA; clean from 2026-11-11.</li></ol><h2>Talking points</h2><ul><li>Lake house down payment: $120,000.00 kept in savings. Confirm timing; the reserve stays in savings, outside the market.</li><li>Charitable giving: gift AAPL (2012-09-17) and MSFT (2015-11-02) to a donor-advised fund. Giving long-held stock instead of cash avoids the capital gain.</li></ul><h2>Proposed actions</h2><ol><li>Rebalance: sell $112,785.60 VTI (Mark Traditional IRA); sell $5,524.80 VXUS (Mark Traditional IRA); buy $118,151.60 AGG (Mark Traditional IRA).</li><li>Harvest BND (2021-08-02) → buy AGG; VNQ (2022-01-03) → buy SCHH (total $30,825.00 loss).</li><li>Hold VXUS (2026-02-09) harvest until 2026-11-11; no VXUS buys in any account before then.</li><li>Convert up to $61,400.00 from Mark Traditional IRA to Roth before Dec 31, 2026.</li><li>Move $68,480.00 of excess savings to the brokerage and invest at target.</li><li>Open a donor-advised fund; gift AAPL (2012-09-17) and MSFT (2015-11-02) ($59,652.00).</li></ol>"
	else
		set n to make new note at f with properties {name:"Henderson — annual review prep (Muselet)", body:"<h1>Henderson — annual review prep (Muselet)</h1><div>Henderson annual review, Mon Oct 26, 2026, 10:00-11:00 · data as of 2026-10-23, computed on this Mac</div><h2>Snapshot</h2><ul><li>Household assets $1,739,656.00: invested $1,503,176.00, savings $236,480.00.</li><li>Allocation vs target (band ±5 pp):</li><ul><li>US equity 47.50% vs 40.00% (+7.50 pp, outside band)</li><li>Intl equity 20.37% vs 20.00% (+0.37 pp)</li><li>Bonds 27.14% vs 35.00% (-7.86 pp, outside band)</li><li>Cash 4.99% vs 5.00% (-0.01 pp)</li><li>Equity total 67.87% vs 60.00% (+7.87 pp, outside band)</li></ul></ul><h2>Opportunities</h2><div>Listed by dollar size; the amounts are different kinds (trades, idle cash, tax room, losses, gains) and are not added together.</div><ol><li><b>Rebalance back to target</b>: $118,151.60 to move. Sell $112,785.60 VTI and $5,524.80 VXUS; buy $118,151.60 AGG in Mark Traditional IRA. AGG instead of BND keeps the BND harvest clean. Realized gain $0.00.</li><li><b>Invest excess savings</b>: $68,480.00 idle in savings. Savings $236,480.00 minus 6-month reserve $48,000.00 minus lake house down payment $120,000.00.</li><li><b>Roth conversion window</b>: $61,400.00 convertible at 22% or less. 22% bracket top $211,400.00 minus taxable income $150,000.00 (2026, IRS Rev. Proc. 2025-32).</li><li><b>Gift appreciated stock to a donor-advised fund</b>: $53,472.00 capital gains avoided. AAPL (2012-09-17) +925.61%, MSFT (2015-11-02) +810.04%; $59,652.00 market value.</li><li><b>Tax-loss harvesting</b>: $30,825.00 losses harvestable now. BND (2021-08-02) $21,825.00 → AGG; VNQ (2022-01-03) $9,000.00 → SCHH. VXUS (2026-02-09) $3,640.00 is wash-sale blocked by the 2026-10-11 buy in Mark Traditional IRA; clean from 2026-11-11.</li></ol><h2>Talking points</h2><ul><li>Lake house down payment: $120,000.00 kept in savings. Confirm timing; the reserve stays in savings, outside the market.</li><li>Charitable giving: gift AAPL (2012-09-17) and MSFT (2015-11-02) to a donor-advised fund. Giving long-held stock instead of cash avoids the capital gain.</li></ul><h2>Proposed actions</h2><ol><li>Rebalance: sell $112,785.60 VTI (Mark Traditional IRA); sell $5,524.80 VXUS (Mark Traditional IRA); buy $118,151.60 AGG (Mark Traditional IRA).</li><li>Harvest BND (2021-08-02) → buy AGG; VNQ (2022-01-03) → buy SCHH (total $30,825.00 loss).</li><li>Hold VXUS (2026-02-09) harvest until 2026-11-11; no VXUS buys in any account before then.</li><li>Convert up to $61,400.00 from Mark Traditional IRA to Roth before Dec 31, 2026.</li><li>Move $68,480.00 of excess savings to the brokerage and invest at target.</li><li>Open a donor-advised fund; gift AAPL (2012-09-17) and MSFT (2015-11-02) ($59,652.00).</li></ol>"}
	end if
end tell
